<import-control pkg="kafka">

  <!-- THINK HARD ABOUT THE LAYERING OF THE PROJECT BEFORE CHANGING THIS FILE -->

  <!-- common library dependencies -->
  <allow pkg="java" />
  <allow pkg="scala" />
  <allow pkg="javax.management" />
  <allow pkg="org.slf4j" />
  <allow pkg="org.junit" />
  <allow pkg="java.security" />
  <allow pkg="javax.net.ssl" />
  <allow pkg="javax.security" />

  <allow pkg="kafka.utils" />
  <allow pkg="org.apache.kafka.clients"/>
  <allow pkg="org.apache.kafka.common" exact-match="true" />
  <allow pkg="org.apache.kafka.common.utils" />
  <allow pkg="org.apache.kafka.common.test.api" />
  <allow pkg="org.apache.kafka.server"/>
  <allow pkg="org.mockito"/>
  <allow pkg="org.opentest4j"/>
  <!-- see KIP-544 for why KafkaYammerMetrics should be used instead of the global default yammer metrics registry
       https://cwiki.apache.org/confluence/display/KAFKA/KIP-544%3A+Make+metrics+exposed+via+JMX+configurable -->
  <disallow class="com.yammer.metrics.Metrics" />
  <allow pkg="com.yammer.metrics"/>

  <subpackage name="tools">
    <allow pkg="kafka.admin" />
    <allow pkg="joptsimple" />
  </subpackage>

  <subpackage name="coordinator">
    <allow class="org.apache.kafka.metadata.MetadataCache" />
  </subpackage>

  <!-- Nereus inject start: exact adapter and stock record bridge -->
  <subpackage name="log">
    <subpackage name="nereus">
      <!-- V2 closed-owner/shared BK composition is confined to this native adapter boundary. -->
      <allow pkg="com.nereusstream.domain" />
      <allow pkg="com.nereusstream.kafka.bookkeeper" />
      <allow pkg="com.nereusstream.storage.api.bookkeeper" />
      <allow pkg="com.nereusstream.storage.api.kafka" />
      <allow pkg="com.nereusstream.storage.api.lifecycle" />
      <allow pkg="com.nereusstream.storage.bookkeeper" />
      <allow pkg="com.nereusstream.storage.object.gc" />
      <allow pkg="com.nereusstream.metadata.oxia.v2" />
      <allow pkg="io.oxia.client.api" />
      <allow class="com.nereusstream.metadata.oxia.VersionedKafkaPartitionBinding" />
      <allow pkg="org.apache.kafka.common.compress" />
      <allow pkg="org.apache.kafka.common.errors" />
      <allow pkg="org.apache.kafka.common.protocol" />
      <allow pkg="org.apache.kafka.common.record" />
      <allow pkg="org.apache.kafka.common.requests" />
      <allow pkg="org.apache.kafka.storage.internals.log" />
      <allow class="org.apache.kafka.storage.log.metrics.BrokerTopicStats" />
      <allow class="org.apache.kafka.storage.internals.utils.Throttler" />
    </subpackage>
  </subpackage>
  <!-- Nereus inject end: exact adapter and stock record bridge -->

  <subpackage name="docker">
    <allow class="com.fasterxml.jackson.annotation.JsonAnyGetter" />
    <allow class="com.fasterxml.jackson.annotation.JsonAnySetter" />
    <allow class="com.fasterxml.jackson.annotation.JsonProperty" />
    <allow class="com.fasterxml.jackson.annotation.JsonPropertyOrder" />
    <allow class="com.fasterxml.jackson.annotation.JsonIgnoreProperties" />
  </subpackage>

  <subpackage name="server">
    <allow pkg="kafka" />
    <allow pkg="org.apache.kafka" />
    <!-- Nereus inject start: exact adapter-backed broker runtime -->
    <subpackage name="nereus">
      <!-- V2 closed-owner/shared BK composition is confined to this native adapter boundary. -->
      <allow pkg="com.nereusstream.domain" />
      <allow pkg="com.nereusstream.kafka.bookkeeper" />
      <allow pkg="com.nereusstream.storage.api.bookkeeper" />
      <allow pkg="com.nereusstream.storage.api.kafka" />
      <allow pkg="com.nereusstream.storage.api.lifecycle" />
      <allow pkg="com.nereusstream.storage.bookkeeper" />
      <allow pkg="com.nereusstream.storage.object.gc" />
      <!-- Exact M5 input/control values used by the native owner adapter. -->
      <allow class="com.nereusstream.storage.object.control.ControlMutationOutcome" />
      <allow class="com.nereusstream.storage.object.materialization.M5MaterializationRecordsV1.PositionDomain" />
      <allow class="com.nereusstream.storage.object.materialization.M5MaterializationRecordsV1.ProtocolCoverage" />
      <allow class="com.nereusstream.storage.object.materialization.M5MaterializationRecordsV1.SourceExtent" />
      <allow class="com.nereusstream.storage.object.materialization.M5MaterializationRecordsV1.SourceKind" />
      <allow class="com.nereusstream.storage.object.materialization.M5MaterializationRecordsV1.IdentityEnvelope" />
      <allow class="com.nereusstream.storage.object.materialization.M5MaterializationRecordsV1.MaterializationSourceCut" />
      <allow class="com.nereusstream.storage.object.materialization.M5MaterializationRecordsV1.PublicationOutcome" />
      <allow class="com.nereusstream.storage.object.materialization.M5MaterializationCodecV1" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlRecordsV1.AdmissionState" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlRecordsV1.CapabilityBinding" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlRecordsV1.BindingIdentity" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlRecordsV1.BindingReadSelector" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlRecordsV1.SelectorMode" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlRecordsV1.ProtectionState" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlRecordsV1.SourceProtection" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlRecordsV1.SourceProtectionIdentity" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlCoordinatorV1" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlCodecV1" />
      <allow class="com.nereusstream.storage.object.read.control.M4ReadControlKeysV1" />
      <allow class="com.nereusstream.storage.object.retention.M5MaterializationWorkerCoordinatorV1" />
      <allow class="com.nereusstream.storage.object.retention.M5TaskSelectionCoordinatorV2" />
      <allow class="com.nereusstream.storage.object.retention.M5TaskSelectionDecisionV2" />
      <allow class="com.nereusstream.storage.object.retention.M5BindingAuthorityCodecV1" />
      <allow class="com.nereusstream.storage.object.retention.M5KafkaBindingPolicyV1" />
      <allow class="com.nereusstream.storage.object.retention.M5BindingLogicalTrimCoordinatorV2" />
      <allow class="com.nereusstream.storage.object.retention.M5ClosedWriterRegistryV1" />
      <allow class="com.nereusstream.storage.object.retention.M5ClosedWriterRegistryV1.WriterDeclarationV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1.FloorClassV1" />
      <allow class="com.nereusstream.storage.object.retention.M5BindingAuthorityRecordsV1.BindingAuthorityStateV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1.AuthorityFactV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1.M4ReleaseBindingV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1.ReferenceObservationV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1.ReferenceKindV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1.ReferenceDispositionV1" />
      <allow class="com.nereusstream.metadata.spi.retention.ExactMetadataTransactionStoreV1.VersionedValue" />
      <allow class="com.nereusstream.metadata.spi.retention.ExactMetadataTransactionStoreV1" />
      <allow class="com.nereusstream.metadata.spi.model.MetadataVersion" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionEvidenceAssemblerV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionEvidenceAssemblerV1.FloorAdapterResultV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionEvidenceAssemblerV1.ReferenceAdapterResultV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1.ReferenceScanSummaryV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1.RetentionFloorObservationV1" />
      <allow class="com.nereusstream.storage.object.gc.DeleteObservationContextV2" />
      <allow class="com.nereusstream.storage.object.gc.DeleteObservationAuthorityVerifierV2" />
      <allow class="com.nereusstream.storage.object.gc.M5GcQuotaCoordinatorV2" />
      <allow class="com.nereusstream.storage.object.gc.M5TargetDeleteAuthorityCoordinatorV1" />
      <allow class="com.nereusstream.storage.object.gc.M5TargetDeleteAuthorityCodecV1" />
      <allow class="com.nereusstream.storage.object.gc.M5TargetDeleteStoredValueV2" />
      <allow class="com.nereusstream.storage.object.gc.M5TargetDeleteAuthorityRecordsV1.ExactExternalIdentityV1" />
      <allow class="com.nereusstream.storage.object.gc.M5TargetDeleteAuthorityRecordsV1.TargetDeleteAuthorityStateV1" />
      <allow class="com.nereusstream.storage.object.retention.M5RetentionRecordsV1" />
      <allow pkg="com.nereusstream.metadata.oxia.v2" />
      <allow pkg="io.oxia.client.api" />
      <allow pkg="org.apache.bookkeeper" />
      <!-- Only the deterministic native release fixture implements the existing raw Cell CAS contract. -->
      <file name="NereusKafkaNativeInputReleaseTest(\.java)?" regex="true">
        <allow class="com.nereusstream.storage.object.control.CanonicalControlMetadataStore" />
      </file>
    </subpackage>
    <!-- Nereus inject end: exact adapter-backed broker runtime -->
  </subpackage>

  <subpackage name="admin">
    <allow pkg="kafka.admin"/>
    <allow pkg="kafka.cluster"/>
    <allow pkg="kafka.log"/>
    <allow pkg="kafka.server"/>
    <allow pkg="org.apache.kafka.coordinator.group"/>
    <allow pkg="org.apache.kafka.metadata"/>
    <allow pkg="org.apache.kafka.security"/>
    <allow pkg="org.apache.kafka.storage.internals.checkpoint"/>
    <allow pkg="org.apache.kafka.storage.internals.log"/>
    <allow pkg="org.apache.kafka.test"/>
    <allow pkg="org.apache.logging.log4j"/>
    <allow pkg="org.apache.kafka.common.test"/>
    <allow pkg="org.apache.kafka.admin"/>
  </subpackage>

  <subpackage name="security">
    <allow pkg="org.apache.commons" />
    <allow pkg="org.apache.directory" />
    <allow pkg="org.apache.mina.core.service" />
    <allow pkg="org.apache.kafka.test" />
  </subpackage>

</import-control>
