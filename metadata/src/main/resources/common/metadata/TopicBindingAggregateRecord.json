{
  "apiKey": 32000,
  "type": "metadata",
  "name": "TopicBindingAggregateRecord",
  "validVersions": "0",
  "flexibleVersions": "none",
  "fields": [
    { "name": "TopicId", "type": "uuid", "versions": "0",
      "about": "The Kafka topic UUID whose image owns this aggregate." },
    { "name": "TopicName", "type": "string", "versions": "0", "entityType": "topicName",
      "about": "The canonical Kafka topic name repeated for identity validation." },
    { "name": "AggregateSchemaVersion", "type": "int16", "versions": "0",
      "about": "The closed logical Topic Binding Aggregate schema version." },
    { "name": "ProtocolKind", "type": "int16", "versions": "0",
      "about": "The closed protocol discriminator." },
    { "name": "BindingId", "type": "bytes", "versions": "0",
      "about": "The exact 32-byte deterministic Topic Binding ID." },
    { "name": "DeploymentId", "type": "uuid", "versions": "0",
      "about": "The non-zero 128-bit Deployment ID." },
    { "name": "KafkaCellId", "type": "uuid", "versions": "0",
      "about": "The non-zero 128-bit Kafka Protocol Cell ID." },
    { "name": "StorageEpochId", "type": "bytes", "versions": "0",
      "about": "The exact 32-byte deterministic initial Storage Epoch ID." },
    { "name": "EpochOrdinal", "type": "int64", "versions": "0",
      "about": "The initial Storage Epoch ordinal, exactly zero in v0." },
    { "name": "StorageProfile", "type": "int16", "versions": "0",
      "about": "The closed V1 storage-profile discriminator." },
    { "name": "ProfileOrigin", "type": "int16", "versions": "0",
      "about": "The closed V1 profile-origin discriminator." },
    { "name": "PolicyCatalogDigest", "type": "bytes", "versions": "0",
      "about": "The exact 32-byte SHA-256 identity of the creation policy catalog." },
    { "name": "FrameEncodingPolicyKind", "type": "int16", "versions": "0",
      "about": "The closed frame-encoding-policy kind." },
    { "name": "FrameEncodingPolicyVersion", "type": "int16", "versions": "0",
      "about": "The closed frame-encoding-policy wire version." },
    { "name": "FrameEncodingPolicyPayload", "type": "bytes", "versions": "0",
      "about": "The exact policy payload, empty for every accepted v0 value." },
    { "name": "InitialSealedEnd", "type": "bytes", "versions": "0", "nullableVersions": "0",
      "about": "The initial sealed end, which must be absent in v0." }
  ]
}
